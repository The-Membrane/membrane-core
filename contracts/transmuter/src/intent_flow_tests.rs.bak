fn default_instantiate_msg() -> TInstantiate {
    TInstantiate {
        owner: Some("owner".to_string()),
        tokenfactory_contract: None,
        cdp_contract: "cdp".to_string(),
        discounts_contract: "discounts".to_string(),
        vault_subdenom: "vt".to_string(),
        deposit_pair: AssetPair {
            cdt: "cdt".to_string(),
            paired_asset: "usdc".to_string(),
        },
        composition_leeway: Decimal::percent(5),
        asset_a_to_b_rate: Decimal::one(),
        target_ratio: Decimal::zero(),
        usage_fee: Some(Decimal::zero()),
        swap_history_cap: 50,
        volume_history_cap: 50,
        rate_limit_window_secs: Some(60),
        rate_limit_threshold: Some(Decimal::percent(10)),
        revenue_distributor_addr: "rev".to_string(),
        revenue_distributions: None,
        allowlist: None,
        allowlist_rate_limit_threshold: None,
        global_rate_limit_window_secs: Some(3600),
        global_rate_limit_threshold: Some(Decimal::percent(10)),
        monthly_incentive_max: Some(Uint128::new(1_000_000)),
        incentive_denom: Some("mbrn".to_string()),
        neutron_proxy: Some("neutron-proxy".to_string()),
        staking_contract: Some("staking".to_string()),
        mars_mirror_contract: Some("mars-mirror".to_string()),
        affiliate_fee: Decimal::percent(1),
    }
}

fn setup_instantiate(
    deps: &mut cosmwasm_std::OwnedDeps<
        cosmwasm_std::MemoryStorage,
        cosmwasm_std::testing::MockApi,
        cosmwasm_std::testing::MockQuerier<cosmwasm_std::Empty>,
    >,
) {
    // Mock discounts contract query to return zero boost
    deps.querier.update_wasm(|_| {
        SystemResult::Ok(ContractResult::Ok(
            to_json_binary(&UserBoostResponse {
                user: "".to_string(),
                boost: Decimal::zero(),
            }).unwrap()
        ))
    });
    
    let env = mock_env();
    let info = mock_info("owner", &[]);
    let msg = default_instantiate_msg();
    let res = instantiate(deps.as_mut(), env.clone(), info, msg).unwrap();
    assert_eq!(res.messages.len(), 1); // create denom
}

fn setup_user_with_incentives(
    deps: &mut cosmwasm_std::OwnedDeps<
        cosmwasm_std::MemoryStorage,
        cosmwasm_std::testing::MockApi,
        cosmwasm_std::testing::MockQuerier<cosmwasm_std::Empty>,
    >,
    user: &str,
    vault_tokens: Uint128,
    claimable_amount: Uint128,
) {
    // Mock discounts contract query to return zero boost
    deps.querier.update_wasm(|_| {
        SystemResult::Ok(ContractResult::Ok(
            to_json_binary(&UserBoostResponse {
                user: "".to_string(),
                boost: Decimal::zero(),
            }).unwrap()
        ))
    });
    let env = mock_env();
    USER_INCENTIVES
        .save(
            &mut deps.storage,
            user.into(),
            &UserIncentives {
                total_claimed: Uint128::zero(),
                vault_tokens_in_contract: vault_tokens,
                last_accrued: 0,
                mbrn_intents: None,
            },
        )
        .unwrap();
    crate::state::VAULT_TOKEN_SUPPLY
        .save(&mut deps.storage, &Uint128::new(1_000_000))
        .unwrap();
    INCENTIVE_EVENTS
        .save(
            &mut deps.storage,
            &vec![IncentiveEvent {
                amount_per_vt: Decimal::from_ratio(claimable_amount, vault_tokens),
                time_of_event: env.block.time.seconds(),
                amount_left_to_claim: claimable_amount,
            }],
        )
        .unwrap();
}

#[test]
fn test_claim_without_intent_tracks_metrics() {
    let mut deps = mock_dependencies();
    setup_instantiate(&mut deps);
    setup_user_with_incentives(&mut deps, "user", Uint128::new(1000), Uint128::new(10000));

    let env = mock_env();
    let info = mock_info("caller", &[]);
    let res = execute(
        deps.as_mut(),
        env.clone(),
        info,
        TExecute::ClaimIncentivesForUser {
            user: "user".into(),
            limit: Some(10),
            mbrn_intent: None,
        },
    )
    .unwrap();

    // Should have mint message for remaining amount (no intent used)
    assert_eq!(res.messages.len(), 1);
    match &res.messages[0].msg {
        CosmosMsg::Wasm(WasmMsg::Execute { contract_addr, .. }) => {
            assert_eq!(contract_addr, "neutron-proxy");
        }
        _ => panic!("Expected WasmMsg::Execute to neutron-proxy"),
    }

    // Check metrics
    let metrics = INTENT_FLOW_METRICS.may_load(&deps.storage).unwrap().unwrap_or_else(|| membrane::transmuter::IntentFlowMetrics {
        total_claims: Uint128::zero(),
        total_no_intent_claims: Uint128::zero(),
        global_intent_totals: Vec::new(),
    });
    assert_eq!(metrics.total_claims, Uint128::new(10000));
    assert_eq!(metrics.total_no_intent_claims, Uint128::new(10000));

    // Check user history
    let history = USER_INTENT_HISTORY.load(&deps.storage, "user".into()).unwrap();
    assert_eq!(history.len(), 1);
    assert_eq!(history[0].amount, Uint128::new(10000));
    assert!(history[0].intents.is_none());
}

#[test]
fn test_claim_with_stake_intent_one_time() {
    let mut deps = mock_dependencies();
    setup_instantiate(&mut deps);
    setup_user_with_incentives(&mut deps, "user", Uint128::new(1000), Uint128::new(10000));

    let env = mock_env();
    let info = mock_info("caller", &[]);
    let intent = MbrnClaimIntent {
        apply_now: true,
        set_ongoing: false,
        intents: vec![MbrnIntentOption {
            intent_type: MbrnIntentType::Stake {},
            ratio: Decimal::one(),
            lock: None,
        }],
    };

    let res = execute(
        deps.as_mut(),
        env.clone(),
        info,
        TExecute::ClaimIncentivesForUser {
            user: "user".into(),
            limit: Some(10),
            mbrn_intent: Some(intent.clone()),
        },
    )
    .unwrap();

    // Should have stake message
    assert_eq!(res.messages.len(), 1);
    match &res.messages[0].msg {
        CosmosMsg::Wasm(WasmMsg::Execute { contract_addr, msg: _, funds }) => {
            assert_eq!(contract_addr, "staking");
            assert_eq!(funds[0].amount, Uint128::new(10000));
            assert_eq!(funds[0].denom, "mbrn");
        }
        _ => panic!("Expected WasmMsg::Execute"),
    }

    // Check metrics
    let metrics = INTENT_FLOW_METRICS.may_load(&deps.storage).unwrap().unwrap_or_else(|| membrane::transmuter::IntentFlowMetrics {
        total_claims: Uint128::zero(),
        total_no_intent_claims: Uint128::zero(),
        global_intent_totals: Vec::new(),
    });
    assert_eq!(metrics.total_claims, Uint128::new(10000));
    assert_eq!(metrics.total_no_intent_claims, Uint128::zero());
    assert_eq!(metrics.global_intent_totals.len(), 1);
    assert_eq!(
        metrics.global_intent_totals[0].total_amount,
        Uint128::new(10000)
    );

    // Check user didn't save ongoing intent
    let user = USER_INCENTIVES.load(&deps.storage, "user".into()).unwrap();
    assert!(user.mbrn_intents.is_none());
}

#[test]
fn test_claim_with_stake_intent_set_ongoing() {
    let mut deps = mock_dependencies();
    setup_instantiate(&mut deps);
    setup_user_with_incentives(&mut deps, "user", Uint128::new(1000), Uint128::new(10000));

    let env = mock_env();
    let info = mock_info("caller", &[]);
    let intent = MbrnClaimIntent {
        apply_now: true,
        set_ongoing: true,
        intents: vec![MbrnIntentOption {
            intent_type: MbrnIntentType::Stake {},
            ratio: Decimal::one(),
            lock: None,
        }],
    };

    let _res = execute(
        deps.as_mut(),
        env.clone(),
        info,
        TExecute::ClaimIncentivesForUser {
            user: "user".into(),
            limit: Some(10),
            mbrn_intent: Some(intent.clone()),
        },
    )
    .unwrap();

    // Check user saved ongoing intent
    let user = USER_INCENTIVES.load(&deps.storage, "user".into()).unwrap();
    assert!(user.mbrn_intents.is_some());
    assert_eq!(user.mbrn_intents.as_ref().unwrap().len(), 1);

    // Second claim should use ongoing intent
    // Need to create a new event that's after the user's last_accrued time
    let mut user = USER_INCENTIVES.load(&deps.storage, "user".into()).unwrap();
    user.vault_tokens_in_contract = Uint128::new(1000); // Keep VT balance
    USER_INCENTIVES.save(&mut deps.storage, "user".into(), &user).unwrap();
    
    // Mock discounts query for second claim
    deps.querier.update_wasm(|_| {
        SystemResult::Ok(ContractResult::Ok(
            to_json_binary(&UserBoostResponse {
                user: "".to_string(),
                boost: Decimal::zero(),
            }).unwrap()
        ))
    });
    
    // Create a new event after last_accrued
    let mut env2 = mock_env();
    env2.block.time = env2.block.time.plus_seconds(10);
    INCENTIVE_EVENTS.save(
        &mut deps.storage,
        &vec![IncentiveEvent {
            amount_per_vt: Decimal::from_ratio(Uint128::new(5000), Uint128::new(1000)),
            time_of_event: env2.block.time.seconds(),
            amount_left_to_claim: Uint128::new(5000),
        }],
    )
    .unwrap();
    let info2 = mock_info("caller", &[]);
    let res2 = execute(
        deps.as_mut(),
        env2,
        info2,
        TExecute::ClaimIncentivesForUser {
            user: "user".into(),
            limit: Some(10),
            mbrn_intent: None, // No intent provided, should use ongoing
        },
    )
    .unwrap();

    // Should still stake
    assert_eq!(res2.messages.len(), 1);
    match &res2.messages[0].msg {
        CosmosMsg::Wasm(WasmMsg::Execute { funds, .. }) => {
            assert_eq!(funds[0].amount, Uint128::new(5000));
        }
        _ => panic!("Expected WasmMsg::Execute"),
    }
}

#[test]
fn test_claim_with_mars_mirror_deposit_intent() {
    let mut deps = mock_dependencies();
    setup_instantiate(&mut deps);
    setup_user_with_incentives(&mut deps, "user", Uint128::new(1000), Uint128::new(10000));

    let env = mock_env();
    let info = mock_info("caller", &[]);
    let intent = MbrnClaimIntent {
        apply_now: true,
        set_ongoing: false,
        intents: vec![MbrnIntentOption {
            intent_type: MbrnIntentType::DepositViaMarsMirror {
                asset: "usdc".to_string(),
                target_ltv: Some(Decimal::percent(75)),
                target_max_borrow_ltv: Some(Decimal::percent(70)),
            },
            ratio: Decimal::one(),
            lock: None,
        }],
    };

    let res = execute(
        deps.as_mut(),
        env.clone(),
        info,
        TExecute::ClaimIncentivesForUser {
            user: "user".into(),
            limit: Some(10),
            mbrn_intent: Some(intent),
        },
    )
    .unwrap();

    // Should have deposit message
    assert_eq!(res.messages.len(), 1);
    match &res.messages[0].msg {
        CosmosMsg::Wasm(WasmMsg::Execute { contract_addr, funds, .. }) => {
            assert_eq!(contract_addr, "mars-mirror");
            assert_eq!(funds[0].amount, Uint128::new(10000));
            assert_eq!(funds[0].denom, "mbrn");
        }
        _ => panic!("Expected WasmMsg::Execute"),
    }

    // Check metrics
    let metrics = INTENT_FLOW_METRICS.may_load(&deps.storage).unwrap().unwrap_or_else(|| membrane::transmuter::IntentFlowMetrics {
        total_claims: Uint128::zero(),
        total_no_intent_claims: Uint128::zero(),
        global_intent_totals: Vec::new(),
    });
    assert_eq!(metrics.global_intent_totals.len(), 1);
    assert!(matches!(
        &metrics.global_intent_totals[0].intent_type,
        MbrnIntentType::DepositViaMarsMirror { asset, .. } if asset == "usdc"
    ));
}

#[test]
fn test_claim_with_multiple_intents_ratios() {
    let mut deps = mock_dependencies();
    setup_instantiate(&mut deps);
    setup_user_with_incentives(&mut deps, "user", Uint128::new(1000), Uint128::new(10000));

    let env = mock_env();
    let info = mock_info("caller", &[]);
    let intent = MbrnClaimIntent {
        apply_now: true,
        set_ongoing: false,
        intents: vec![
            MbrnIntentOption {
                intent_type: MbrnIntentType::Stake {},
                ratio: Decimal::percent(60),
                lock: None,
            },
            MbrnIntentOption {
                intent_type: MbrnIntentType::DepositViaMarsMirror {
                    asset: "usdc".to_string(),
                    target_ltv: None,
                    target_max_borrow_ltv: None,
                },
                ratio: Decimal::percent(40),
                lock: None,
            },
        ],
    };

    let res = execute(
        deps.as_mut(),
        env.clone(),
        info,
        TExecute::ClaimIncentivesForUser {
            user: "user".into(),
            limit: Some(10),
            mbrn_intent: Some(intent),
        },
    )
    .unwrap();

    // Should have 2 messages (stake + deposit)
    assert_eq!(res.messages.len(), 2);

    // Check amounts (60% stake, 40% deposit)
    let mut stake_amount = Uint128::zero();
    let mut deposit_amount = Uint128::zero();
    for msg in &res.messages {
        match &msg.msg {
            CosmosMsg::Wasm(WasmMsg::Execute { contract_addr, funds, .. }) => {
                if contract_addr == "staking" {
                    stake_amount = funds[0].amount;
                } else if contract_addr == "mars-mirror" {
                    deposit_amount = funds[0].amount;
                }
            }
            _ => {}
        }
    }

    assert_eq!(stake_amount, Uint128::new(6000)); // 60% of 10000
    assert_eq!(deposit_amount, Uint128::new(4000)); // 40% of 10000

    // Check metrics
    let metrics = INTENT_FLOW_METRICS.may_load(&deps.storage).unwrap().unwrap_or_else(|| membrane::transmuter::IntentFlowMetrics {
        total_claims: Uint128::zero(),
        total_no_intent_claims: Uint128::zero(),
        global_intent_totals: Vec::new(),
    });
    assert_eq!(metrics.global_intent_totals.len(), 2);
}

#[test]
fn test_claim_with_locked_stake() {
    let mut deps = mock_dependencies();
    setup_instantiate(&mut deps);
    setup_user_with_incentives(&mut deps, "user", Uint128::new(1000), Uint128::new(10000));

    let env = mock_env();
    let info = mock_info("caller", &[]);
    let lock = Locked {
        locked_until: env.block.time.seconds() + 86400,
        perpetual_lock: None,
    };
    let intent = MbrnClaimIntent {
        apply_now: true,
        set_ongoing: false,
        intents: vec![MbrnIntentOption {
            intent_type: MbrnIntentType::Stake {},
            ratio: Decimal::one(),
            lock: Some(lock.clone()),
        }],
    };

    let res = execute(
        deps.as_mut(),
        env.clone(),
        info,
        TExecute::ClaimIncentivesForUser {
            user: "user".into(),
            limit: Some(10),
            mbrn_intent: Some(intent),
        },
    )
    .unwrap();

    // Check stake message includes lock
    match &res.messages[0].msg {
        CosmosMsg::Wasm(WasmMsg::Execute { msg, .. }) => {
            // The msg should contain the lock information
            // This is tested via the contract logic, so we just verify the message exists
            assert!(!msg.to_vec().is_empty());
        }
        _ => panic!("Expected WasmMsg::Execute"),
    }
}

